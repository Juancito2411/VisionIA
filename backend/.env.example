DATABASE_URL=sqlite:///./vision_ai.db
# Modelo general COCO: personas, vehículos y objetos comunes.
YOLO_MODEL=yolov8n.pt
# Modelo especializado PPE: guantes, casco, gafas, chaleco, máscara, cono, escalera, persona y clases de ausencia.
# Se descarga automáticamente desde Hugging Face la primera vez que se inicia la inferencia.
YOLO_PPE_MODEL=hf://Hexmon/vyra-yolo-ppe-detection/best.pt
# Mantener true para combinar detección general + EPP. Usa false si solo quieres PPE.
YOLO_ENABLE_GENERAL=true

# Mayor sensibilidad para objetos EPP pequeños (casco/guantes/chaleco).
YOLO_PPE_CONFIDENCE=0.08
YOLO_PPE_IMGSZ=960
YOLO_PPE_AUGMENT=false
YOLO_GENERAL_IMGSZ=640
YOLO_NMS_IOU=0.45
YOLO_MAX_DETECTIONS=100
